# Copiar a .env.prod en el servidor de producción (no versionado, ver .gitignore)
# y rellenar con los valores reales. Nunca comitear este fichero con valores reales.
DATABASE_URL=postgres://appuser:REPLACE_ME@127.0.0.1:5432/appdb
# Secreto de firma de los tokens de sesión (JWT) — generar uno propio, nunca reutilizar el de local.
AUTH_TOKEN_SECRET=
# IP de Tailscale del servidor — restringe la API a esa interfaz, no a toda la red.
SERVER_ADDRESS=[tailscale-ip-redactada]
# API key de Resend (cuenta real, dominio verificado) — nunca la de desarrollo.
RESEND_API_KEY=
# Remitente con el dominio verificado en Resend, formato "Nombre <direccion@dominio>".
RESEND_FROM_ADDRESS=
# URL pública HTTPS real del servidor (ver ADR-036: Tailscale Funnel, no la IP
# interna de Tailscale — un usuario fuera del tailnet no podría abrir el enlace).
PUBLIC_API_BASE_URL=
# Fotos de ruta (ver openspec/changes/almacenamiento-fotos-backend, ADR-042).
# host:puerto de MinIO — 127.0.0.1:9000 con network_mode: host (mismo loopback
# dentro y fuera del contenedor, igual que DATABASE_URL).
MINIO_ENDPOINT=127.0.0.1:9000
# Credenciales de un usuario de MinIO dedicado a apps/api, acotado solo al
# bucket MINIO_BUCKET (política propia) — nunca las credenciales root de MinIO.
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=images
# Clave AES-256 de cifrado de fotos — 32 bytes exactos codificados en base64
# (p. ej. openssl rand -base64 32). Perderla hace irrecuperables todas las
# fotos ya subidas, para siempre — sin mecanismo de rotación (ver ADR-042).
PHOTO_ENCRYPTION_KEY=
